# Haunt Director settings. Copy to backend/.env and edit. Every setting is HD_<NAME>;
# see backend/haunt_director/config.py for the full list. Restart the app after changes:
#   sudo systemctl restart haunt-director

# How light frames reach FPP. "ddp" (recommended): one UDP packet per frame straight
# into fppd, with a 1-second dead-man switch. "rest": FPP's HTTP overlay API (fallback).
HD_OUTPUT_TRANSPORT=ddp

# BCM pin your presence sensor's OUT is wired to (you can also set it in the app).
# HD_PRESENCE_GPIO_PIN=4

# Safety: cap every strobe at this many flashes per second (scenes AND Live cards).
# The UK Health and Safety Executive recommends 4 or less where the public can see it,
# which is exactly a front yard on Halloween. Set 0 to remove the cap. See docs/safety.md.
HD_STROBE_MAX_HZ=4

# Optional: AI scene drafting. Bring your own key. Leave blank to turn the feature off.
# HD_LLM_PROVIDER=anthropic        # or: openai
# HD_LLM_API_KEY=
# HD_LLM_MODEL=claude-sonnet-5     # or e.g. gpt-4o for openai

# Optional: let a frontend served from another origin call the API (comma separated).
# Leave empty unless you know you need it.
# HD_CORS_ORIGINS=
